# Supabase Postgres runtime connection. Use the pooled URL for deployed serverless runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase non-transaction migration connection. Prefer Direct connection; use Session pooler
# when Direct connection is not reachable from the local/deploy environment.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-only. Never expose this to browser code or NEXT_PUBLIC_* variables.
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional local/admin Auth password management for internal users.
# AUTH_USERNAME="pablo"
# AUTH_PASSWORD="temporary-password"
# AUTH_USER_ID="00000000-0000-0000-0000-000000000000"

# Optional one-time profile bootstrap inputs for an existing Supabase Auth user.
# BOOTSTRAP_AUTH_USER_ID="00000000-0000-0000-0000-000000000000"
# BOOTSTRAP_USERNAME="sebas"
# BOOTSTRAP_EMAIL="sebas@sebasam.local"
# BOOTSTRAP_DISPLAY_NAME="Sebas"
# BOOTSTRAP_ROLE="ADMIN"

# Gemini provider (server-only). Used by the historical import embeddings and
# the assistant (filter extraction + answers). Never expose these to browser
# code or NEXT_PUBLIC_* variables.
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
# GEMINI_ANSWER_MODEL="gemini-3.5-flash-lite"
