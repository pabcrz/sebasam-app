generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ADMIN_ASSISTANT
  WORKER
}

enum WorkerKind {
  MASTER
  HELPER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CANCELLED
  ARCHIVED
}

enum QuoteItemType {
  LABOR
  MATERIAL
  REFACCIONES
  OTHER
}

enum WorkOrderStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum KnowledgeIndexState {
  PENDING
  INDEXING
  INDEXED
  FAILED
  INELIGIBLE
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DONE
  CANCELLED
}

enum PaymentRequestStatus {
  PENDING
  VIEWED
  FISCAL_DATA_REQUIRED
  READY_TO_PAY
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}


enum PaymentStatus {
  PENDING
  PAID
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerMovementType {
  NOTE_CHARGE
  PAYMENT_CAPTURE
  PAYMENT_APPLICATION
  PAYMENT_REVERSAL
  APPLICATION_REVERSAL
}

enum QuoteDecisionOrigin {
  CUSTOMER
  ADMIN
}

enum PersonType {
  INDIVIDUAL
  BUSINESS
}

model UserProfile {
  id          String      @id @db.Uuid
  username    String      @unique
  email       String      @unique
  displayName String
  role        UserRole    @default(WORKER)
  workerKind  WorkerKind?
  isActive    Boolean     @default(true)
  mustChangePassword Boolean @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  assignments          WorkAssignment[]
  executionRecords     ExecutionRecord[]
  quoteLifecycleEvents QuoteLifecycleEvent[]
  reversedPayments     Payment[]            @relation("PaymentReverser")
  createdApplications PaymentApplication[] @relation("PaymentApplicationCreator")
  reversedApplications PaymentApplication[] @relation("PaymentApplicationReverser")
  ledgerEntries        LedgerEntry[]        @relation("LedgerEntryActor")
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  status    CustomerStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  quotes          Quote[]
  vehicles        Vehicle[]
  fiscalProfiles  CustomerFiscalProfile[]
  paymentRequests PaymentRequest[]
  payments        Payment[]
  ledgerEntries   LedgerEntry[]
}

model Vehicle {
  id         String   @id @default(cuid())
  customerId String
  brand      String?
  model      String?
  year       Int?
  color      String?
  plate      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotes   Quote[]

  @@unique([customerId, plate])
}

model Quote {
  id              String      @id @default(cuid())
  submissionKey   String?     @unique
  submissionHash  String?
  customerId      String?
  vehicleId       String?
  number          String      @unique
  status          QuoteStatus @default(DRAFT)
  title           String
  description     String?
  vehicleSnapshot Json?
  subtotalCents   Int?
  discountCents   Int         @default(0)
  taxCents        Int?
  totalCents      Int?
  taxEnabled      Boolean     @default(true)
  validUntil      DateTime    @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '7 days'"))
  approvedAt      DateTime?
  administrative  Boolean     @default(false)
  operationalDate DateTime    @db.Date
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  customer        Customer?        @relation(fields: [customerId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  sections        QuoteSection[]
  items           QuoteItem[]
  workOrder       WorkOrder?
  paymentRequests PaymentRequest[]
  payments        Payment[]
  sharedQuotes    SharedQuote[]
  decisions       QuoteDecision[]
  lifecycleEvents QuoteLifecycleEvent[]

  @@index([operationalDate])
}

model SharedQuote {
  id        String    @id @default(cuid())
  token     String    @unique
  quoteId   String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([token])
}

model QuoteDecision {
  id                   String              @id @default(cuid())
  quoteId              String
  status               QuoteStatus
  origin               QuoteDecisionOrigin
  actorId              String?
  note                 String?
  authorizedSectionIds String[]            @default([])
  createdAt            DateTime            @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteLifecycleEvent {
  id            String      @id @default(cuid())
  quoteId       String
  previousState QuoteStatus
  nextState     QuoteStatus
  actorId       String      @db.Uuid
  reason        String
  createdAt     DateTime    @default(now())

  quote Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor UserProfile @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([quoteId, createdAt])
  @@index([actorId])
}

model QuoteSection {
  id           String      @id @default(cuid())
  quoteId      String
  name         String
  sortOrder    Int         @default(0)
  isAuthorized Boolean     @default(false)
  items        QuoteItem[]

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteItem {
  id                 String        @id @default(cuid())
  quoteId            String
  sectionId          String?
  type               QuoteItemType
  description        String
  quantity           Decimal       @db.Decimal(10, 2)
  unitPriceCents     Int?
  totalCents         Int?
  includeInPayroll       Boolean       @default(false)
  customRatePercent      Int?
  customPayrollBaseCents Int?
  sortOrder              Int           @default(0)

  quote   Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  section QuoteSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completedWorkKnowledgeSources CompletedWorkKnowledgeSource[]
  
  @@index([sectionId])
}

model WorkOrder {
  id                            String          @id @default(cuid())
  quoteId                       String          @unique
  number                        String          @unique
  status                        WorkOrderStatus @default(PLANNED)
  scheduledFor                  DateTime?
  siteAddress                   String?
  notes                         String?
  completedAt                   DateTime?
  isSpecial                     Boolean         @default(false)
  specialAssigneeName           String?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  quote               Quote                @relation(fields: [quoteId], references: [id])
  assignments         WorkAssignment[]
  executionRecords    ExecutionRecord[]
  paymentRequests     PaymentRequest[]
  paymentApplications PaymentApplication[]
  ledgerEntries       LedgerEntry[]
  completedWorkKnowledgeSources CompletedWorkKnowledgeSource[]

  @@index([status, completedAt])
}

model CompletedWorkKnowledgeSource {
  id                String              @id @default(cuid())
  originKey         String              @unique
  workOrderId       String
  quoteItemId       String
  contextText       String
  contextHash       String
  embedding         Unsupported("vector(1536)")?
  indexState        KnowledgeIndexState @default(PENDING)
  indexingAttempts  Int                 @default(0)
  lastIndexError    String?
  lastAttemptedAt   DateTime?
  indexedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, quoteItemId])
  @@index([workOrderId, indexState])
  @@map("completed_work_knowledge_sources")
}

model WorkAssignment {
  id          String           @id @default(cuid())
  workOrderId String
  workerId    String           @db.Uuid
  status      AssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime         @default(now())
  notes       String?

  workOrder WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  worker    UserProfile @relation(fields: [workerId], references: [id])

  @@unique([workOrderId, workerId])
}

model ExecutionRecord {
  id              String   @id @default(cuid())
  workOrderId     String
  workerId        String?  @db.Uuid
  summary         String
  notes           String?
  progressPercent Int      @default(0)
  isExtra         Boolean  @default(false)
  happenedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  worker    UserProfile? @relation(fields: [workerId], references: [id])
}

model CustomerFiscalProfile {
  id           String     @id @default(cuid())
  customerId   String
  personType   PersonType @default(INDIVIDUAL)
  businessName String
  taxId        String
  taxRegime    String?
  cfdiUse      String?
  zipCode      String?
  address      String?
  email        String?
  phone        String?
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentRequests PaymentRequest[]

  @@unique([customerId, taxId])
  @@index([customerId])
}

model PaymentRequest {
  id                      String               @id @default(cuid())
  token                   String               @unique
  status                  PaymentRequestStatus @default(PENDING)
  customerId              String
  quoteId                 String?
  workOrderId             String?
  requiresInvoice         Boolean              @default(false)
  customerFiscalProfileId String?
  fiscalSnapshot          Json?
  expiresAt               DateTime
  viewedAt                DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote                 Quote?                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  workOrder             WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customerFiscalProfile CustomerFiscalProfile? @relation(fields: [customerFiscalProfileId], references: [id], onDelete: SetNull)
  payments              Payment[]

  @@index([customerId])
  @@index([quoteId])
  @@index([workOrderId])
  @@index([token])
}

model Payment {
  id               String        @id @default(cuid())
  operationKey     String        @unique
  customerId       String
  quoteId          String?
  paymentRequestId String?
  method           PaymentMethod
  amountCents      Int
  status           PaymentStatus @default(PAID)
  reversedAt       DateTime?
  reversalReason   String?
  reversedById     String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote          Quote?               @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  paymentRequest PaymentRequest?      @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  reversedBy     UserProfile?         @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  applications   PaymentApplication[]
  ledgerEntries  LedgerEntry[]

  @@index([customerId])
  @@index([quoteId])
  @@index([paymentRequestId])
  @@index([quoteId, status])
  @@index([status, createdAt])
  @@index([reversedAt])
}

model PaymentApplication {
  id             String    @id @default(cuid())
  operationKey   String    @unique
  paymentId      String
  workOrderId    String
  amountCents    Int
  actorId        String?   @db.Uuid
  reversedAt     DateTime?
  reversalReason String?
  reversedById   String?   @db.Uuid
  createdAt      DateTime  @default(now())

  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor         UserProfile?  @relation("PaymentApplicationCreator", fields: [actorId], references: [id], onDelete: Restrict)
  reversedBy    UserProfile?  @relation("PaymentApplicationReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([paymentId])
  @@index([workOrderId])
  @@index([reversedAt])
}

model LedgerEntry {
  id                    String             @id @default(cuid())
  customerId            String
  type                  LedgerEntryType
  movementType          LedgerMovementType
  amountCents           Int
  resultingBalanceCents Int?
  actorId               String?            @db.Uuid
  reason                String?
  paymentId             String?
  paymentApplicationId  String?
  workOrderId           String?
  reversedMovementId    String?            @unique
  createdAt             DateTime           @default(now())

  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment            Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentApplication PaymentApplication? @relation(fields: [paymentApplicationId], references: [id], onDelete: Restrict)
  workOrder          WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor              UserProfile?        @relation("LedgerEntryActor", fields: [actorId], references: [id], onDelete: Restrict)
  reversedMovement   LedgerEntry?        @relation("MovementReversal", fields: [reversedMovementId], references: [id], onDelete: Restrict)
  reversalMovement   LedgerEntry?        @relation("MovementReversal")

  @@index([customerId, createdAt])
  @@index([paymentId])
  @@index([paymentApplicationId])
  @@index([workOrderId])
}

model PaymentSettings {
  id              Int      @id @default(1)
  name            String   @default("SEBASAM")
  fullName        String   @default("Servicio Básico a Suspensiones y Aire y Muelles")
  address         String   @default("Batalla de Casa Blanca 1719B, Leyes de Reforma, Iztapalapa, 09310 Ciudad de México, CDMX")
  mapsUrl         String   @default("https://maps.app.goo.gl/MYuGBKwabPGbea7y7")
  contactPhone    String   @default("5556007675")
  contactWhatsapp String   @default("5536239346")
  hours           Json     @default("{\"weekdays\":\"Lunes a viernes de 9:00 a 18:00\",\"saturday\":\"Sábados de 9:00 a 15:00\"}")
  services        String[] @default(["Alineación de ejes", "Brio a muelles", "Refuerzos", "Soldadura"])
  products        String[] @default(["Abrazaderas", "Bujes", "Perchas", "Columpios", "Tensores", "Balancines"])
  updatedAt       DateTime @updatedAt

  bankAccounts BankAccount[]
}

model BankAccount {
  id                  Int      @id @default(autoincrement())
  paymentSettingsId   Int
  accountHolder       String
  bankName            String
  accountNumber       String
  clabe               String
  isForInvoicing      Boolean  @default(false)
  isPubliclyShareable Boolean  @default(false)
  publicToken         String   @unique @default(uuid())
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  paymentSettings PaymentSettings @relation(fields: [paymentSettingsId], references: [id], onDelete: Cascade)

  @@index([paymentSettingsId])
}

model HistoricalWork {
  id           String   @id @default(cuid())
  batchId      String
  workRef      String
  workDate     DateTime @db.Date
  customerName String?
  plate        String?
  brand        String?
  model        String?
  masterName   String?
  masterId     String?  @db.Uuid
  source       String   @default("text")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items HistoricalWorkItem[]

  @@unique([batchId, workRef])
  @@index([workDate])
  @@map("historical_works")
}

model HistoricalWorkItem {
  id                 String             @id @default(cuid())
  workId             String
  type               QuoteItemType
  description        String
  quantity           Decimal?           @db.Decimal(10, 2)
  customerPriceCents Int?
  payrollBaseCents   Int?
  ratePercent        Int?
  includeInPayroll   Boolean            @default(false)
  isKit              Boolean            @default(false)
  sortOrder          Int                @default(0)
  embedding          Unsupported("vector(1536)")
  metadata           Json               @default("{}")
  contentHash        String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  work HistoricalWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([type, description])
  @@map("historical_work_items")
}
