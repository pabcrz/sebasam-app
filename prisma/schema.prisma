generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  ADMIN_ASSISTANT
  WORKER
}

enum WorkerKind {
  MASTER
  HELPER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CANCELLED
}

enum QuoteItemType {
  SERVICE
  MATERIAL
  LABOR
  EQUIPMENT
  OTHER
}

enum WorkOrderStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DONE
  CANCELLED
}

enum PaymentRequestStatus {
  PENDING
  VIEWED
  FISCAL_DATA_REQUIRED
  READY_TO_PAY
  EXPIRED
  CANCELLED
}

enum QuoteDecisionOrigin {
  CUSTOMER
  ADMIN
}

enum PersonType {
  INDIVIDUAL
  BUSINESS
}

model UserProfile {
  id          String      @id @db.Uuid
  username    String      @unique
  email       String      @unique
  displayName String
  role        UserRole    @default(WORKER)
  workerKind  WorkerKind?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  assignments      WorkAssignment[]
  executionRecords ExecutionRecord[]
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  status    CustomerStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  quotes          Quote[]
  vehicles        Vehicle[]
  fiscalProfiles  CustomerFiscalProfile[]
  paymentRequests PaymentRequest[]
}

model Vehicle {
  id         String   @id @default(cuid())
  customerId String
  brand      String?
  model      String?
  year       Int?
  color      String?
  plate      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotes   Quote[]

  @@unique([customerId, plate])
}

model Quote {
  id              String      @id @default(cuid())
  customerId      String
  vehicleId       String?
  number          String      @unique
  status          QuoteStatus @default(DRAFT)
  title           String
  description     String?
  vehicleSnapshot Json?
  subtotalCents   Int         @default(0)
  taxCents        Int         @default(0)
  totalCents      Int         @default(0)
  taxEnabled      Boolean     @default(true)
  validUntil      DateTime    @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '7 days'"))
  approvedAt      DateTime?
  administrative  Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  workOrder       WorkOrder?
  paymentRequests PaymentRequest[]
  sharedQuotes    SharedQuote[]
  decisions       QuoteDecision[]
}

model SharedQuote {
  id        String    @id @default(cuid())
  token     String    @unique
  quoteId   String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([token])
}

model QuoteDecision {
  id        String              @id @default(cuid())
  quoteId   String
  status    QuoteStatus
  origin    QuoteDecisionOrigin
  actorId   String?
  note      String?
  createdAt DateTime            @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteItem {
  id             String        @id @default(cuid())
  quoteId        String
  type           QuoteItemType
  description    String
  quantity       Decimal       @db.Decimal(10, 2)
  unitPriceCents Int
  totalCents     Int
  sortOrder      Int           @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id           String          @id @default(cuid())
  quoteId      String          @unique
  number       String          @unique
  status       WorkOrderStatus @default(PLANNED)
  scheduledFor DateTime?
  siteAddress  String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  quote            Quote             @relation(fields: [quoteId], references: [id])
  assignments      WorkAssignment[]
  executionRecords ExecutionRecord[]
  paymentRequests  PaymentRequest[]
}

model WorkAssignment {
  id          String           @id @default(cuid())
  workOrderId String
  workerId    String           @db.Uuid
  status      AssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime         @default(now())
  notes       String?

  workOrder WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  worker    UserProfile @relation(fields: [workerId], references: [id])

  @@unique([workOrderId, workerId])
}

model ExecutionRecord {
  id          String   @id @default(cuid())
  workOrderId String
  workerId    String?  @db.Uuid
  summary     String
  happenedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  worker    UserProfile? @relation(fields: [workerId], references: [id])
}

model CustomerFiscalProfile {
  id           String     @id @default(cuid())
  customerId   String
  personType   PersonType @default(INDIVIDUAL)
  businessName String
  taxId        String
  taxRegime    String?
  cfdiUse      String?
  zipCode      String?
  address      String?
  email        String?
  phone        String?
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentRequests PaymentRequest[]

  @@unique([customerId, taxId])
  @@index([customerId])
}

model PaymentRequest {
  id                      String               @id @default(cuid())
  token                   String               @unique
  status                  PaymentRequestStatus @default(PENDING)
  customerId              String
  quoteId                 String?
  workOrderId             String?
  requiresInvoice         Boolean              @default(false)
  customerFiscalProfileId String?
  fiscalSnapshot          Json?
  expiresAt               DateTime
  viewedAt                DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote                 Quote?                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  workOrder             WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customerFiscalProfile CustomerFiscalProfile? @relation(fields: [customerFiscalProfileId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([quoteId])
  @@index([workOrderId])
  @@index([token])
}

model PaymentSettings {
  id              Int      @id @default(1)
  name            String   @default("SEBASAM")
  fullName        String   @default("Servicio Básico a Suspensiones y Aire y Muelles")
  address         String   @default("Batalla de Casa Blanca 1719B, Leyes de Reforma, Iztapalapa, 09310 Ciudad de México, CDMX")
  mapsUrl         String   @default("https://maps.app.goo.gl/MYuGBKwabPGbea7y7")
  contactPhone    String   @default("5556007675")
  contactWhatsapp String   @default("5536239346")
  updatedAt       DateTime @updatedAt

  bankAccounts BankAccount[]
}

model BankAccount {
  id                Int      @id @default(autoincrement())
  paymentSettingsId Int
  accountHolder     String
  bankName          String
  accountNumber     String
  clabe             String
  isForInvoicing    Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  paymentSettings PaymentSettings @relation(fields: [paymentSettingsId], references: [id], onDelete: Cascade)

  @@index([paymentSettingsId])
}
