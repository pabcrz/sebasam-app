generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ADMIN_ASSISTANT
  WORKER
}

enum WorkerKind {
  MASTER
  HELPER
}

enum CustomerContactRole {
  DRIVER
  CONTACT
  BILLING
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CANCELLED
  ARCHIVED
}

enum QuoteItemType {
  LABOR
  MATERIAL
  REFACCIONES
  OTHER
}

enum WorkOrderStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum KnowledgeIndexState {
  PENDING
  INDEXING
  INDEXED
  FAILED
  INELIGIBLE
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DONE
  CANCELLED
}

enum PaymentRequestStatus {
  PENDING
  VIEWED
  FISCAL_DATA_REQUIRED
  READY_TO_PAY
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}


enum PaymentStatus {
  PENDING
  PAID
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerMovementType {
  NOTE_CHARGE
  PAYMENT_CAPTURE
  PAYMENT_APPLICATION
  PAYMENT_REVERSAL
  APPLICATION_REVERSAL
}

enum QuoteDecisionOrigin {
  CUSTOMER
  ADMIN
}

enum PersonType {
  INDIVIDUAL
  BUSINESS
}

enum QuoteLifecycleEventType {
  STATUS_CHANGE
  LOCK
  UNLOCK
  CONVERT_TO_NOTE
  RETURN_TO_QUOTE
}

enum SettlementAgreementStatus {
  ACTIVE
  CANCELLED
}

enum PayrollPeriodStatus {
  OPEN
  CLOSED
  PAID
  ARCHIVED
}

model UserProfile {
  id          String      @id @db.Uuid
  username    String      @unique
  email       String      @unique
  displayName String
  role        UserRole    @default(WORKER)
  workerKind  WorkerKind?
  fixedWeeklyPayCents Int?
  fixedDailyPayCents  Int?
  isActive    Boolean     @default(true)
  mustChangePassword Boolean @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  assignments          WorkAssignment[]
  executionRecords     ExecutionRecord[]
  quoteLifecycleEvents QuoteLifecycleEvent[]
  reversedPayments     Payment[]            @relation("PaymentReverser")
  createdApplications PaymentApplication[] @relation("PaymentApplicationCreator")
  reversedApplications PaymentApplication[] @relation("PaymentApplicationReverser")
  ledgerEntries        LedgerEntry[]        @relation("LedgerEntryActor")
  helperPayrollWeeks   HelperPayrollWeek[]
  paymentCorrections   PaymentCorrection[]
  quoteCommercialCorrections QuoteCommercialCorrection[]
  lockedQuotes         Quote[]              @relation("QuoteLockedBy")
  settlementAgreements SettlementAgreement[] @relation("SettlementAgreementActor")
  settlementAgreementRevisions SettlementAgreementRevision[] @relation("SettlementAgreementRevisionActor")
  cancelledSettlementAgreements SettlementAgreement[] @relation("SettlementAgreementCanceller")
  revokedSharedQuotes  SharedQuote[]        @relation("SharedQuoteRevoker")
  receivedLaborAdvances WorkOrderLaborAdvance[] @relation("AdvanceWorker")
  createdLaborAdvances  WorkOrderLaborAdvance[] @relation("AdvanceCreatedBy")
  closedPayrollWeeks    PayrollWeekControl[]    @relation("WeekClosedBy")
  reopenedPayrollWeeks  PayrollWeekControl[]    @relation("WeekReopenedBy")
}

model HelperPayrollWeek {
  id                    String   @id @default(cuid())
  workerId              String   @db.Uuid
  weekStart             DateTime @db.Date
  weeklyRateCents       Int
  dailyRateCents        Int
  absenceDays           Int      @default(0)
  manualCommissionCents Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  worker UserProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([workerId, weekStart])
  @@index([weekStart])
}

model Customer {
  id             String         @id @default(cuid())
  name           String
  commercialName String?
  legalName      String?
  email          String?
  phone          String?
  address        String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  quotes          Quote[]
  vehicles        Vehicle[]
  contacts        CustomerContact[]
  fiscalProfiles  CustomerFiscalProfile[]
  paymentRequests PaymentRequest[]
  payments        Payment[]
  ledgerEntries   LedgerEntry[]

  @@index([name])
  @@index([commercialName])
  @@index([phone])
}

model CustomerContact {
  id         String              @id @default(cuid())
  customerId String
  name       String
  phone      String?
  role       CustomerContactRole @default(CONTACT)
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotes   Quote[]

  @@index([customerId])
  @@index([phone])
  @@index([name])
  @@index([role])
}

model Vehicle {
  id             String   @id @default(cuid())
  customerId     String
  economicNumber String?
  brand          String?
  model          String?
  year           Int?
  color          String?
  plate          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotes   Quote[]

  @@unique([customerId, plate])
  @@index([economicNumber])
}

model Quote {
  id                      String      @id @default(cuid())
  submissionKey           String?     @unique
  submissionHash          String?
  customerId              String?
  vehicleId               String?
  customerContactId       String?
  customerFiscalProfileId String?
  number                  String      @unique
  folio                   String?     @unique
  issuedAt                DateTime?
  status                  QuoteStatus @default(DRAFT)
  title                   String
  description             String?
  vehicleSnapshot         Json?
  customerSnapshot        Json?
  contactSnapshot         Json?
  subtotalCents           Int?
  discountCents           Int         @default(0)
  taxCents                Int?
  totalCents              Int?
  taxEnabled              Boolean     @default(true)
  validUntil              DateTime    @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '7 days'"))
  approvedAt              DateTime?
  administrative          Boolean     @default(false)
  operationalDate         DateTime    @db.Date
  isLocked                Boolean     @default(false)
  lockedAt                DateTime?
  lockedById              String?     @db.Uuid
  lockedReason            String?
  paymentDueDate          DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  deletedAt               DateTime?

  customer              Customer?              @relation(fields: [customerId], references: [id])
  vehicle               Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customerContact       CustomerContact?       @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  customerFiscalProfile CustomerFiscalProfile? @relation(fields: [customerFiscalProfileId], references: [id], onDelete: SetNull)
  lockedBy              UserProfile?           @relation("QuoteLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  sections              QuoteSection[]
  items                 QuoteItem[]
  workOrder             WorkOrder?
  paymentRequests       PaymentRequest[]
  payments              Payment[]
  sharedQuotes          SharedQuote[]
  decisions             QuoteDecision[]
  lifecycleEvents       QuoteLifecycleEvent[]
  commercialCorrections QuoteCommercialCorrection[]
  settlementAgreement   SettlementAgreement?

  @@index([operationalDate])
  @@index([customerContactId])
  @@index([customerFiscalProfileId])
  @@index([lockedById])
}

model SharedQuote {
  id               String       @id @default(cuid())
  token            String       @unique
  quoteId          String
  expiresAt        DateTime
  revokedAt        DateTime?
  isCanonical      Boolean      @default(false)
  revokedByUserId  String?      @db.Uuid
  revocationReason String?
  createdAt        DateTime     @default(now())

  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  revokedByUser UserProfile? @relation("SharedQuoteRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([quoteId, isCanonical])
  @@index([token])
  @@index([revokedByUserId])
}

model QuoteDecision {
  id                   String              @id @default(cuid())
  quoteId              String
  status               QuoteStatus
  origin               QuoteDecisionOrigin
  actorId              String?
  note                 String?
  authorizedSectionIds String[]            @default([])
  createdAt            DateTime            @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteLifecycleEvent {
  id            String                  @id @default(cuid())
  quoteId       String
  eventType     QuoteLifecycleEventType @default(STATUS_CHANGE)
  previousState QuoteStatus
  nextState     QuoteStatus
  actorId       String                  @db.Uuid
  reason        String
  createdAt     DateTime                @default(now())

  quote Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor UserProfile @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([quoteId, createdAt])
  @@index([quoteId, eventType])
  @@index([actorId])
}

model QuoteSection {
  id           String      @id @default(cuid())
  quoteId      String
  name         String
  sortOrder    Int         @default(0)
  isAuthorized Boolean     @default(false)
  items        QuoteItem[]

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteItem {
  id                 String        @id @default(cuid())
  quoteId            String
  sectionId          String?
  type               QuoteItemType
  description        String
  quantity           Decimal       @db.Decimal(10, 2)
  unitPriceCents     Int?
  totalCents         Int?
  includeInPayroll       Boolean       @default(false)
  customRatePercent      Int?
  customPayrollBaseCents Int?
  payrollConfigLockedAt  DateTime?
  sortOrder              Int           @default(0)

  quote   Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  section QuoteSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completedWorkKnowledgeSources CompletedWorkKnowledgeSource[]
  laborAdvances         WorkOrderLaborAdvance[]
  
  @@index([sectionId])
}

model WorkOrder {
  id                            String          @id @default(cuid())
  quoteId                       String          @unique
  number                        String          @unique
  folio                         String?         @unique
  issuedAt                      DateTime?
  status                        WorkOrderStatus @default(PLANNED)
  scheduledFor                  DateTime?
  siteAddress                   String?
  notes                         String?
  completedAt                   DateTime?
  paymentDueDate                DateTime?
  isSpecial                     Boolean         @default(false)
  specialAssigneeName           String?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  quote                         Quote                          @relation(fields: [quoteId], references: [id])
  assignments                   WorkAssignment[]
  executionRecords              ExecutionRecord[]
  paymentRequests               PaymentRequest[]
  paymentApplications           PaymentApplication[]
  ledgerEntries                 LedgerEntry[]
  completedWorkKnowledgeSources CompletedWorkKnowledgeSource[]
  paymentCorrectionApplications PaymentCorrectionApplication[]
  commercialCorrections         QuoteCommercialCorrection[]
  commercialCorrectionApplications QuoteCommercialCorrectionApplication[]
  laborAdvances                 WorkOrderLaborAdvance[]

  @@index([status, completedAt])
  @@index([status, paymentDueDate])
}

model CompletedWorkKnowledgeSource {
  id                String              @id @default(cuid())
  originKey         String              @unique
  workOrderId       String
  quoteItemId       String
  contextText       String
  contextHash       String
  embedding         Unsupported("vector(1536)")?
  indexState        KnowledgeIndexState @default(PENDING)
  indexingAttempts  Int                 @default(0)
  lastIndexError    String?
  lastAttemptedAt   DateTime?
  indexedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, quoteItemId])
  @@index([workOrderId, indexState])
  @@map("completed_work_knowledge_sources")
}

model WorkAssignment {
  id          String           @id @default(cuid())
  workOrderId String
  workerId    String           @db.Uuid
  status      AssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime         @default(now())
  notes       String?

  workOrder WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  worker    UserProfile @relation(fields: [workerId], references: [id])

  @@unique([workOrderId, workerId])
}

model ExecutionRecord {
  id              String   @id @default(cuid())
  workOrderId     String
  workerId        String?  @db.Uuid
  summary         String
  notes           String?
  progressPercent Int      @default(0)
  isExtra         Boolean  @default(false)
  happenedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  worker    UserProfile? @relation(fields: [workerId], references: [id])
}

model CustomerFiscalProfile {
  id           String     @id @default(cuid())
  customerId   String
  personType   PersonType @default(INDIVIDUAL)
  businessName String
  taxId        String
  taxRegime    String?
  cfdiUse      String?
  zipCode      String?
  address      String?
  email        String?
  phone        String?
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentRequests PaymentRequest[]
  quotes          Quote[]

  @@unique([customerId, taxId])
  @@index([customerId])
  @@index([businessName])
}

model PaymentRequest {
  id                      String               @id @default(cuid())
  token                   String               @unique
  status                  PaymentRequestStatus @default(PENDING)
  customerId              String
  quoteId                 String?
  workOrderId             String?
  requiresInvoice         Boolean              @default(false)
  customerFiscalProfileId String?
  fiscalSnapshot          Json?
  expiresAt               DateTime
  viewedAt                DateTime?
  payableSubtotalCents    Int?
  payableTaxCents         Int?
  payableTotalCents       Int?
  settlementAgreementId   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote                 Quote?                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  workOrder             WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customerFiscalProfile CustomerFiscalProfile? @relation(fields: [customerFiscalProfileId], references: [id], onDelete: SetNull)
  payments              Payment[]

  @@index([customerId])
  @@index([quoteId])
  @@index([workOrderId])
  @@index([token])
}

model SettlementAgreement {
  id                   String                  @id @default(cuid())
  quoteId              String                  @unique
  status               SettlementAgreementStatus @default(ACTIVE)
  nominalSubtotalCents Int
  nominalTaxCents      Int
  nominalTotalCents    Int
  settlementBaseCents  Int
  settlementTaxCents   Int
  settlementTotalCents Int
  reason               String
  actorId              String                  @db.Uuid
  cancelledAt          DateTime?
  cancelledById        String?                 @db.Uuid
  cancellationReason   String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  quote       Quote                       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  actor       UserProfile                 @relation("SettlementAgreementActor", fields: [actorId], references: [id], onDelete: Restrict)
  cancelledBy UserProfile?                @relation("SettlementAgreementCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  revisions   SettlementAgreementRevision[]

  @@index([status])
  @@index([actorId])
}

model SettlementAgreementRevision {
  id                  String   @id @default(cuid())
  settlementAgreementId String
  revisionNumber      Int
  nominalSubtotalCents Int
  nominalTaxCents     Int
  nominalTotalCents   Int
  settlementBaseCents Int
  settlementTaxCents  Int
  settlementTotalCents Int
  reason              String
  actorId             String   @db.Uuid
  createdAt           DateTime @default(now())

  settlementAgreement SettlementAgreement @relation(fields: [settlementAgreementId], references: [id], onDelete: Restrict)
  actor               UserProfile         @relation("SettlementAgreementRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([settlementAgreementId, revisionNumber])
  @@index([settlementAgreementId, createdAt])
}

model Payment {
  id               String        @id @default(cuid())
  operationKey     String        @unique
  customerId       String
  quoteId          String?
  paymentRequestId String?
  method           PaymentMethod
  amountCents      Int
  status           PaymentStatus @default(PAID)
  reversedAt       DateTime?
  reversalReason   String?
  reversedById     String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote                Quote?               @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  paymentRequest       PaymentRequest?      @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)
  reversedBy           UserProfile?         @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  applications         PaymentApplication[]
  ledgerEntries        LedgerEntry[]
  correctionsOriginal  PaymentCorrection[]  @relation("OriginalPaymentCorrection")
  correctionsReplacement PaymentCorrection[] @relation("ReplacementPaymentCorrection")

  @@index([customerId])
  @@index([quoteId])
  @@index([paymentRequestId])
  @@index([quoteId, status])
  @@index([status, createdAt])
  @@index([reversedAt])
}

model PaymentApplication {
  id             String    @id @default(cuid())
  operationKey   String    @unique
  paymentId      String
  workOrderId    String
  amountCents    Int
  actorId        String?   @db.Uuid
  reversedAt     DateTime?
  reversalReason String?
  reversedById   String?   @db.Uuid
  createdAt      DateTime  @default(now())

  payment                    Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  workOrder                  WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor                      UserProfile?  @relation("PaymentApplicationCreator", fields: [actorId], references: [id], onDelete: Restrict)
  reversedBy                 UserProfile?  @relation("PaymentApplicationReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  ledgerEntries              LedgerEntry[]
  originalCorrectionMappings PaymentCorrectionApplication[] @relation("OriginalCorrectionApplication")
  replacementCorrectionMappings PaymentCorrectionApplication[] @relation("ReplacementCorrectionApplication")
  originalQuoteCorrectionMappings QuoteCommercialCorrectionApplication[] @relation("OriginalQuoteCorrectionApplication")
  replacementQuoteCorrectionMappings QuoteCommercialCorrectionApplication[] @relation("ReplacementQuoteCorrectionApplication")

  @@index([paymentId])
  @@index([workOrderId])
  @@index([reversedAt])
}

model QuoteCommercialCorrection {
  id                   String   @id @default(cuid())
  operationKey         String   @unique
  quoteId              String
  workOrderId          String
  previousTotalCents   Int
  newTotalCents        Int
  previousAppliedCents Int
  newAppliedCents      Int
  excessCreditCents    Int      @default(0)
  reason               String
  actorId              String   @db.Uuid
  createdAt            DateTime @default(now())

  quote        Quote                               @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  workOrder    WorkOrder                           @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor        UserProfile                         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  applications QuoteCommercialCorrectionApplication[]

  @@index([quoteId, createdAt])
  @@index([workOrderId, createdAt])
  @@index([actorId])
}

model QuoteCommercialCorrectionApplication {
  id                       String   @id @default(cuid())
  correctionId             String
  originalApplicationId    String
  reversalLedgerEntryId    String
  replacementApplicationId String?
  replacementLedgerEntryId String?
  workOrderId              String
  originalAmountCents      Int
  reversalAmountCents      Int
  replacementAmountCents   Int      @default(0)
  releasedCreditCents      Int      @default(0)
  sortOrder                Int      @default(0)
  createdAt                DateTime @default(now())

  correction             QuoteCommercialCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  originalApplication    PaymentApplication       @relation("OriginalQuoteCorrectionApplication", fields: [originalApplicationId], references: [id], onDelete: Restrict)
  reversalLedgerEntry    LedgerEntry              @relation("QuoteCorrectionReversalLedger", fields: [reversalLedgerEntryId], references: [id], onDelete: Restrict)
  replacementApplication PaymentApplication?      @relation("ReplacementQuoteCorrectionApplication", fields: [replacementApplicationId], references: [id], onDelete: SetNull)
  replacementLedgerEntry LedgerEntry?             @relation("QuoteCorrectionReplacementLedger", fields: [replacementLedgerEntryId], references: [id], onDelete: SetNull)
  workOrder              WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@unique([correctionId, originalApplicationId])
  @@index([correctionId])
  @@index([workOrderId])
}

model PaymentCorrection {
  id                   String   @id @default(cuid())
  operationKey         String   @unique
  originalPaymentId    String
  replacementPaymentId String
  reason               String
  actorId              String   @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  originalPayment    Payment                     @relation("OriginalPaymentCorrection", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  replacementPayment Payment                     @relation("ReplacementPaymentCorrection", fields: [replacementPaymentId], references: [id], onDelete: Restrict)
  actor              UserProfile                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  applications       PaymentCorrectionApplication[]

  @@unique([originalPaymentId])
  @@index([originalPaymentId])
  @@index([replacementPaymentId])
  @@index([actorId])
}

model PaymentCorrectionApplication {
  id                       String  @id @default(cuid())
  paymentCorrectionId      String
  originalApplicationId    String
  replacementApplicationId String?
  workOrderId              String
  originalAmountCents      Int
  replacementAmountCents   Int
  shortfallCents           Int     @default(0)
  sortOrder                Int     @default(0)
  createdAt                DateTime @default(now())

  paymentCorrection      PaymentCorrection  @relation(fields: [paymentCorrectionId], references: [id], onDelete: Cascade)
  originalApplication    PaymentApplication @relation("OriginalCorrectionApplication", fields: [originalApplicationId], references: [id], onDelete: Restrict)
  replacementApplication PaymentApplication? @relation("ReplacementCorrectionApplication", fields: [replacementApplicationId], references: [id], onDelete: SetNull)
  workOrder              WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@unique([paymentCorrectionId, originalApplicationId])
  @@index([paymentCorrectionId])
  @@index([workOrderId])
}

model LedgerEntry {
  id                    String             @id @default(cuid())
  customerId            String
  type                  LedgerEntryType
  movementType          LedgerMovementType
  amountCents           Int
  resultingBalanceCents Int?
  actorId               String?            @db.Uuid
  reason                String?
  paymentId             String?
  paymentApplicationId  String?
  workOrderId           String?
  reversedMovementId    String?            @unique
  createdAt             DateTime           @default(now())

  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment            Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentApplication PaymentApplication? @relation(fields: [paymentApplicationId], references: [id], onDelete: Restrict)
  workOrder          WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor              UserProfile?        @relation("LedgerEntryActor", fields: [actorId], references: [id], onDelete: Restrict)
  reversedMovement   LedgerEntry?        @relation("MovementReversal", fields: [reversedMovementId], references: [id], onDelete: Restrict)
  reversalMovement   LedgerEntry?        @relation("MovementReversal")
  quoteCorrectionReversals QuoteCommercialCorrectionApplication[] @relation("QuoteCorrectionReversalLedger")
  quoteCorrectionReplacements QuoteCommercialCorrectionApplication[] @relation("QuoteCorrectionReplacementLedger")

  @@index([customerId, createdAt])
  @@index([paymentId])
  @@index([paymentApplicationId])
  @@index([workOrderId])
}

model PaymentSettings {
  id              Int      @id @default(1)
  name            String   @default("SEBASAM")
  fullName        String   @default("Servicio Básico a Suspensiones y Aire y Muelles")
  address         String   @default("Batalla de Casa Blanca 1719B, Leyes de Reforma, Iztapalapa, 09310 Ciudad de México, CDMX")
  mapsUrl         String   @default("https://maps.app.goo.gl/MYuGBKwabPGbea7y7")
  contactPhone    String   @default("5556007675")
  contactWhatsapp String   @default("5536239346")
  hours           Json     @default("{\"weekdays\":\"Lunes a viernes de 9:00 a 18:00\",\"saturday\":\"Sábados de 9:00 a 15:00\"}")
  services        String[] @default(["Alineación de ejes", "Brio a muelles", "Refuerzos", "Soldadura"])
  products        String[] @default(["Abrazaderas", "Bujes", "Perchas", "Columpios", "Tensores", "Balancines"])
  updatedAt       DateTime @updatedAt

  bankAccounts BankAccount[]
}

model BankAccount {
  id                  Int      @id @default(autoincrement())
  paymentSettingsId   Int
  accountHolder       String
  bankName            String
  accountNumber       String
  clabe               String
  isForInvoicing      Boolean  @default(false)
  isPubliclyShareable Boolean  @default(false)
  publicToken         String   @unique @default(uuid())
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  paymentSettings PaymentSettings @relation(fields: [paymentSettingsId], references: [id], onDelete: Cascade)

  @@index([paymentSettingsId])
}

model HistoricalWork {
  id           String   @id @default(cuid())
  batchId      String
  workRef      String
  workDate     DateTime @db.Date
  customerName String?
  plate        String?
  brand        String?
  model        String?
  masterName   String?
  masterId     String?  @db.Uuid
  source       String   @default("text")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items HistoricalWorkItem[]

  @@unique([batchId, workRef])
  @@index([workDate])
  @@map("historical_works")
}

model HistoricalWorkItem {
  id                 String             @id @default(cuid())
  workId             String
  type               QuoteItemType
  description        String
  quantity           Decimal?           @db.Decimal(10, 2)
  customerPriceCents Int?
  payrollBaseCents   Int?
  ratePercent        Int?
  includeInPayroll   Boolean            @default(false)
  isKit              Boolean            @default(false)
  sortOrder          Int                @default(0)
  embedding          Unsupported("vector(1536)")
  metadata           Json               @default("{}")
  contentHash        String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  work HistoricalWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([type, description])
  @@map("historical_work_items")
}

model DailyDocumentSequence {
  id           String   @id @default(cuid())
  documentType String
  businessDate String   @db.VarChar(10) // YYYY-MM-DD
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([documentType, businessDate])
}

model WorkOrderLaborAdvance {
  id                    String      @id @default(cuid())
  workOrderId           String
  quoteItemId           String
  workerId              String      @db.Uuid
  weekStart             DateTime    @db.Date

  advanceBaseCents      Int
  advancePercentage     Int
  commissionRatePercent Int
  commissionCents       Int

  notes                 String?
  createdById           String?     @db.Uuid
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  workOrder             WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  quoteItem             QuoteItem   @relation(fields: [quoteItemId], references: [id], onDelete: Restrict)
  worker                UserProfile @relation("AdvanceWorker", fields: [workerId], references: [id], onDelete: Restrict)
  createdBy             UserProfile? @relation("AdvanceCreatedBy", fields: [createdById], references: [id])

  @@unique([quoteItemId, weekStart])
  @@index([workOrderId, weekStart])
  @@index([workerId, weekStart])
}

model PayrollWeekControl {
  id           String              @id @default(cuid())
  weekStart    DateTime            @unique @db.Date
  status       PayrollPeriodStatus @default(CLOSED)
  closedAt     DateTime?
  closedById   String?             @db.Uuid
  reopenedAt   DateTime?
  reopenedById String?             @db.Uuid
  reopenReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  closedBy     UserProfile?        @relation("WeekClosedBy", fields: [closedById], references: [id])
  reopenedBy   UserProfile?        @relation("WeekReopenedBy", fields: [reopenedById], references: [id])
}
